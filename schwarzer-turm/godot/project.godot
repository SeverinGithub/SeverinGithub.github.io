; Der Schwarze Turm – Godot-Fassung (Vorbereitung, siehe docs/Godot-Umstieg.md)

config_version=5

[application]

config/name="Der Schwarze Turm"
config/description="Isometrisches Action-RPG – Umstieg aus der Browser-Fassung"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Data="*res://scripts/data.gd"

[display]

window/size/viewport_width=760
window/size/viewport_height=430
window/size/window_width_override=1520
window/size/window_height_override=860
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input]

move_click={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
